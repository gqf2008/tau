#pragma once
// Minimal std::expected<void, E> for the freestanding wasm32 build (this
// toolchain ships no libc++). Covers exactly what wit-bindgen cpp emits
// for `result<_, string>` host-import returns (0.2.0 host channel):
// default (success) construction, unexpected(error) construction, moves.
#include <utility>

namespace std {

template <class E>
class unexpected {
  public:
    E err;
    unexpected(const E& e) : err(e) {}
    unexpected(E&& e) : err(move(e)) {}
};
template <class E>
unexpected(E) -> unexpected<E>;

// Value form. The 0.3.0 host channel made the generated bindings instantiate
// it for real: host.subscribe -> expected<uint64_t, string> and host.poll ->
// expected<vector<stream-event>, string>. The example never calls them, so
// these bodies only have to compile and link -- but they are written to work
// anyway (value/unexpected construction, moves, has_value/value/error).
template <class T, class E>
class expected {
    bool ok;
    alignas(T) unsigned char vbuf[sizeof(T)];
    alignas(E) unsigned char ebuf[sizeof(E)];
    T* v() { return reinterpret_cast<T*>(vbuf); }
    E* e() { return reinterpret_cast<E*>(ebuf); }

  public:
    expected(const T& val) : ok(true) { new (vbuf) T(val); }
    expected(T&& val) : ok(true) { new (vbuf) T(move(val)); }
    template <class G>
    expected(const unexpected<G>& u) : ok(false) {
        new (ebuf) E(u.err);
    }
    template <class G>
    expected(unexpected<G>&& u) : ok(false) {
        new (ebuf) E(move(u.err));
    }
    expected(expected&& o) : ok(o.ok) {
        if (ok)
            new (vbuf) T(move(*o.v()));
        else
            new (ebuf) E(move(*o.e()));
    }
    expected& operator=(expected&& o) {
        if (ok)
            v()->~T();
        else
            e()->~E();
        ok = o.ok;
        if (ok)
            new (vbuf) T(move(*o.v()));
        else
            new (ebuf) E(move(*o.e()));
        return *this;
    }
    ~expected() {
        if (ok)
            v()->~T();
        else
            e()->~E();
    }
    bool has_value() const { return ok; }
    explicit operator bool() const { return ok; }
    T& value() & { return *v(); }
    T&& value() && { return move(*v()); }
    E& error() & { return *e(); }
    const E& error() const& { return *e(); }
};

template <class E>
class expected<void, E> {
    bool ok;
    alignas(E) unsigned char buf[sizeof(E)];
    E* e() { return reinterpret_cast<E*>(buf); }

  public:
    expected() : ok(true) {}
    template <class G>
    expected(const unexpected<G>& u) : ok(false) {
        new (buf) E(u.err);
    }
    template <class G>
    expected(unexpected<G>&& u) : ok(false) {
        new (buf) E(move(u.err));
    }
    expected(expected&& o) : ok(o.ok) {
        if (!ok)
            new (buf) E(move(*o.e()));
    }
    expected& operator=(expected&& o) {
        if (!ok)
            e()->~E();
        ok = o.ok;
        if (!ok)
            new (buf) E(move(*o.e()));
        return *this;
    }
    ~expected() {
        if (!ok)
            e()->~E();
    }
    bool has_value() const { return ok; }
    explicit operator bool() const { return ok; }
    E& error() & { return *e(); }
};

} // namespace std
