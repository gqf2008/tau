#pragma once
#include <utility>
namespace std {
struct nullopt_t { explicit constexpr nullopt_t(int) {} };
constexpr nullopt_t nullopt{0};
template <class T> class optional {
    bool has = false;
    alignas(T) unsigned char buf[sizeof(T)];
    T* p() { return reinterpret_cast<T*>(buf); }
    const T* p() const { return reinterpret_cast<const T*>(buf); }
  public:
    optional() = default;
    optional(nullopt_t) {}
    optional(const T& v) : has(true) { new (buf) T(v); }
    optional(T&& v) : has(true) { new (buf) T(move(v)); }
    optional(optional&& o) : has(o.has) { if (has) new (buf) T(move(*o.p())); }
    optional& operator=(optional&& o) {
        if (has) p()->~T();
        has = o.has;
        if (has) new (buf) T(move(*o.p()));
        return *this;
    }
    ~optional() { if (has) p()->~T(); }
    template <class... Args> T& emplace(Args&&... args) {
        if (has) p()->~T();
        new (buf) T(static_cast<Args&&>(args)...);
        has = true;
        return *p();
    }
    T& operator*() & { return *p(); }
    T&& operator*() && { return move(*p()); }
    bool has_value() const { return has; }
    explicit operator bool() const { return has; }
    T& value() & { return *p(); }
    const T& value() const& { return *p(); }
    T&& value() && { return move(*p()); }
};
}
