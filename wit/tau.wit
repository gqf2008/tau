package tau:extension@0.3.0;

/// ---- Message trunk: tau owns this schema, so it is typed, not JSON ----
///
/// Content blocks and messages shared by the host channel (see
/// docs/host-channel.md). Convention (docs/extensions.md): payloads whose
/// schema tau owns are WIT types; JSON survives only at leaves tau does
/// not own the schema for (tool arguments, JSON Schema, probe payloads,
/// extension-defined facts).
interface types {
    /// Who produced a message. Mirrors tau_core::types::Role.
    enum role {
        /// The human (or the harness on their behalf).
        user,
        /// The model.
        assistant,
        /// A tool result message.
        tool,
    }

    /// A media payload: image, audio, video, or an arbitrary file. The
    /// MIME major type carries the semantics (image/*, audio/*, video/*;
    /// anything else is a file). Raw bytes cross the ABI — never base64.
    record media {
        /// MIME type, e.g. "image/png", "audio/pcm;rate=24000".
        media-type: string,
        /// Where the bytes live.
        source: media-source,
        /// Original filename — file semantics only. The host rejects a
        /// name on image/audio/video media.
        name: option<string>,
    }

    /// Where a media's bytes live. Mirrors tau_core::types::MediaSource.
    variant media-source {
        /// Raw bytes.
        bytes(list<u8>),
        /// Remote reference; providers that accept URLs use it directly.
        url(string),
        /// Content-addressed blob store reference: "sha256:<hex>".
        blob(string),
    }

    /// A tool invocation requested by the assistant.
    record tool-call {
        /// Provider-assigned call id (echoed back by tool-result).
        id: string,
        /// Registered tool name.
        name: string,
        /// The one JSON leaf: model-produced arbitrary JSON arguments.
        arguments-json: string,
    }

    /// A block of a tool result. A separate, non-recursive variant: a
    /// tool result never contains tool calls or nested results (and
    /// wasmtime's host bindgen rejects recursive types outright).
    variant result-block {
        /// A plain text block.
        text(string),
        /// A media block (image, audio, video, file).
        media(media),
    }

    /// The outcome of one tool call, as conversation content. Multi-block
    /// since 0.3.0 (docs/tool-media.md, wit-review F4): text and/or media;
    /// media bytes cross the ABI raw, never base64.
    record tool-result {
        /// The call this answers.
        call-id: string,
        /// Result blocks: text and/or media.
        content: list<result-block>,
        /// True when the tool reported failure.
        is-error: bool,
    }

    /// One block of a message's content. Mirrors tau_core::types::Content
    /// with image/audio/video/file collapsed into media (MIME major is
    /// the semantics).
    variant content {
        /// A plain text block.
        text(string),
        /// A media block (image, audio, video, file).
        media(media),
        /// A tool invocation requested by the assistant.
        tool-call(tool-call),
        /// The outcome of one tool call.
        tool-result(tool-result),
    }

    /// One message in the conversation: a role plus ordered blocks.
    record message {
        /// Who produced it.
        role: role,
        /// Ordered blocks: text, media, tool calls/results.
        content: list<content>,
    }
}

/// Tools an extension contributes to the agent.
interface tools {
    use types.{result-block};

    /// A tool the model may call, described with a JSON Schema parameter object.
    record definition {
        name: string,
        description: string,
        /// JSON Schema for the tool's arguments, serialized. JSON because
        /// JSON Schema is itself a schema language tau does not own.
        parameters-json: string,
    }

    record tool-result {
        /// Result blocks handed back to the model: text and/or media
        /// (multi-block since 0.3.0, docs/tool-media.md). The call-id is
        /// paired host-side; the guest never sees it.
        content: list<result-block>,
        is-error: bool,
    }

    /// Called once at load time to enumerate the tools this component provides.
    definitions: func() -> list<definition>;

    /// Execute one tool call. `arguments-json` is the model-produced JSON
    /// object matching the definition's schema.
    execute: func(name: string, arguments-json: string) -> tool-result;
}

/// Probes: lifecycle points where an extension can observe and influence a
/// run. See docs/probes.md for the point list and payload shapes.
/// (Named `hooks` in 0.1.0; renamed to match the code, the docs, and the
/// `tau probes` CLI — wit-review F7.)
interface probes {
    enum action {
        /// No opinion; run proceeds unchanged.
        continue,
        /// Use payload-json as the replacement for the probed value.
        replace,
        /// Veto the action; reason is handed back to the model or user.
        block,
    }

    record verdict {
        action: action,
        /// Replacement payload for `replace`, point-specific JSON.
        payload-json: option<string>,
        /// Reason for `block`.
        reason: option<string>,
    }

    /// Probe points this component handles (e.g. ["before_tool"]).
    /// Empty list = observe nothing, called once at load time.
    points: func() -> list<string>;

    /// Synchronous probe call. The harness pauses until the verdict returns,
    /// so handlers on the hot path must be fast.
    probe: func(point: string, payload-json: string) -> verdict;
}

/// Push channel from a provider component back to the host. Not a
/// capability: the host always provides it. Typed in 0.2.0 — the
/// model-event schema is tau-owned, and typing kills the base64 hot path
/// audio-delta had on the 0.1.0 JSON envelope. `emit` returns a result so
/// a host-side rejection reaches the guest instead of vanishing
/// (wit-review F2/F6: the 0.1.0 silent-skip path is gone).
interface events {
    /// Why a response ended. Mirrors tau_core::model::StopReason.
    enum stop-reason {
        /// The model finished its turn.
        stop,
        /// The model wants tool calls executed.
        tool-use,
        /// Hit the output limit.
        length,
        /// Ended by a failure (a prior `error` event says what).
        error,
        /// Cancelled from outside (e.g. a steering interrupt).
        aborted,
    }

    /// Incremental assistant audio (realtime-style providers). Chunks of
    /// one contiguous segment share a media type; concatenating them in
    /// order must yield valid content of that type. Raw bytes, not base64.
    record audio-delta {
        /// The audio bytes of this chunk.
        data: list<u8>,
        /// MIME type shared by the contiguous segment this chunk belongs to.
        media-type: string,
    }

    /// Incremental tool-call data. Deltas for one call share `index`;
    /// `id`/`name` arrive (typically once) before its argument fragments.
    record tool-call-delta {
        /// Groups the deltas of one call (calls may interleave).
        index: u32,
        /// The call's id, on its first delta.
        id: option<string>,
        /// The tool's name, on its first delta.
        name: option<string>,
        /// A fragment of the JSON arguments text.
        arguments-delta: string,
    }

    /// One incremental model output. Mirrors tau_core::model::ModelEvent.
    variant model-event {
        /// Incremental assistant text.
        text-delta(string),
        /// Incremental tool-call data.
        tool-call-delta(tool-call-delta),
        /// Incremental assistant audio.
        audio-delta(audio-delta),
        /// Terminal: the response ended successfully for the given reason.
        done(stop-reason),
        /// Terminal failure — always followed by `done(error)`.
        error(string),
    }

    /// Push one model event. The result reports host-side rejection;
    /// guests should treat an error as terminal for this stream.
    emit: func(event: model-event) -> result<_, string>;
}

/// A model provider. Streaming is push-mode: the component calls
/// `events.emit` per chunk and returns from `run` when the response is
/// complete. Provider components typically need scoped network access
/// (declared in metadata, granted by user consent); when the user hands
/// the host a bearer token (`--provider-auth` / TAU_PROVIDER_AUTH), it
/// arrives inside the request payload as "auth": {"bearer": token} —
/// giving the token IS the consent to place it in guest memory, and the
/// host never persists it.
interface models {
    record info {
        /// Model id passed in requests (e.g. "gpt-5", "claude-sonnet-4-5").
        id: string,
        name: string,
        context-window: u32,
        max-output: u32,
    }

    /// Models this provider can serve.
    list-models: func() -> list<info>;

    /// Run one streaming request to completion, pushing events via `emit`.
    /// request-json: {"model": string, "system": string|null,
    ///   "messages": [...], "tools": [...],
    ///   "auth"?: {"bearer": string}} using tau's message wire shape.
    /// Stays JSON: the provider's job is translating to a vendor wire
    /// format, which is JSON — it re-serializes regardless, and there is
    /// no hot path here (unlike emit's audio-delta).
    /// Contract (same as the native Model trait): never trap for
    /// request/transport failures; report via an error event followed by
    /// done{stop:"error"}.
    run: func(request-json: string);
}

/// Guest→host channel: an extension's active return path. Facts
/// (notify/emit) are always available; decisions (steer/follow-up) are
/// consent-gated (per-fingerprint remembered grant; the consent UX says
/// "this component may inject messages into the session"). Every call
/// enqueues — none re-enters the agent loop synchronously; delivery
/// follows the control channel's existing checkpoint rules (steer lands
/// after the in-flight tool results of the current turn, follow-up when
/// the run finishes). See docs/host-channel.md 语义红线.
interface host {
    use types.{message, content};

    /// A provider audio segment on the stream subscription. The bytes
    /// themselves never travel this channel (same rule as the bus: they
    /// land in the assistant message as content); observers see the
    /// count and media type.
    record audio-segment {
        /// How many bytes arrived in this segment.
        bytes: u64,
        /// The media type of the segment they belong to.
        media-type: string,
    }

    /// One high-frequency stream event drained by `poll`
    /// (docs/stream-subscribe.md).
    variant stream-event {
        /// The subscription's ring overran: n events were dropped
        /// before the next event in this batch.
        lagged(u64),
        /// A fragment of assistant text.
        text-delta(string),
        /// A provider audio segment.
        audio-delta(audio-segment),
    }

    /// User-visible notification; the renderer draws text blocks and a
    /// placeholder for media blocks. Not added to model history.
    /// level: "info" | "warn" | "error".
    notify: func(level: string, content: list<content>) -> result<_, string>;

    /// Publish an extension-defined fact to the event bus (observe-only).
    /// The fact's schema is external to tau, so this stays a JSON leaf;
    /// it must still be well-formed JSON, or the result says so.
    emit: func(event-json: string) -> result<_, string>;

    /// Steer the current run: the message is queued into the control
    /// channel and lands at the next checkpoint. Consent-gated; the host
    /// validates role==user and size limits and reports violations.
    steer: func(message: message) -> result<_, string>;

    /// Queue a message to run after the agent finishes. Same consent and
    /// validation as steer.
    follow-up: func(message: message) -> result<_, string>;

    /// Subscribe to high-frequency stream events, returning a handle
    /// (docs/stream-subscribe.md — F2's high-frequency leg). Topic
    /// catalog: "text-delta", "audio-delta"; an unknown topic fails
    /// loudly. Guests pull — the host never calls into a component
    /// asynchronously, so the drain happens inside the guest's own
    /// invocations and the subscription's granularity is the guest's
    /// own call frequency. Outside a run (e.g. during definitions) the
    /// bus is not wired and subscribe fails.
    subscribe: func(topics: list<string>) -> result<u64, string>;

    /// Non-blocking drain of a subscription's backlog (empty when
    /// nothing accumulated). The ring holds 1024 events (mirroring the
    /// bus); on overrun the batch starts with lagged(n). An unknown
    /// handle — including one from before a trap rebuild, handles do
    /// not survive it — is an error.
    poll: func(subscription: u64) -> result<list<stream-event>, string>;

    /// Unsubscribe and drop the backlog. An unknown handle is an error.
    unsubscribe: func(subscription: u64) -> result<_, string>;
}

/// General extension: tools and/or probes, plus the host channel.
/// Ambient WASI (fs/env/stdio/args/network) is granted by default —
/// pass --deny-wasi to the host CLI to run components with no ambient
/// capabilities.
world extension {
    import host;
    export tools;
    export probes;
}

/// Model provider extension. `events.emit` is the push channel. Network
/// access comes from the same consent-gated `http` capability bridges
/// use: always linked, granted empty by default, every request's origin
/// checked against the per-component allowlist (remembered per signing
/// fingerprint). With no consent, calls fail at call time.
world provider {
    import events;
    import http;
    export models;
}

/// Spawn-with-pipes: a generic host capability for bridge components.
/// NOT linked for ordinary extensions; the host grants it per component,
/// per command, with explicit user consent (the consent UX shows argv).
/// Deliberately plain-data: no wasi:io dependency, no MCP awareness.
interface process {
    /// Spawn argv[0] with args and a filtered environment.
    /// Returns a handle or an error message.
    spawn: func(argv: list<string>) -> result<u64, string>;

    /// Append bytes to the child's stdin.
    write-stdin: func(handle: u64, data: list<u8>) -> result<_, string>;

    /// Read up to `max` bytes from the child's stdout. Blocks until at
    /// least one byte is available or the stream closes (eof = true).
    read-stdout: func(handle: u64, max: u32) -> result<tuple<list<u8>, bool>, string>;

    /// Terminate the child and close the handle. Returns a result since
    /// 0.2.0 — a kill failure is reported, not swallowed (wit-review F8).
    /// Handles carry a host-side generation: a stale handle after close
    /// errors instead of aliasing a newer child.
    kill: func(handle: u64) -> result<_, string>;
}

/// HTTP requests: a scoped network capability for bridge components. The
/// host holds an origin allowlist built from explicit user consent; every
/// request's origin (scheme + host + port) is checked against it before
/// sending, and redirects are never followed. Plain data, handle-based,
/// same shape as `process` — no wasi:http dependency.
interface http {
    /// Start a request. Fails if the url's origin is not in the consent
    /// allowlist. Returns a response handle. `method` is passed through
    /// verbatim — send uppercase ("GET", "POST"); servers are
    /// case-sensitive about method names.
    request: func(method: string, url: string, headers: list<tuple<string, string>>, body: list<u8>) -> result<u64, string>;

    /// HTTP status code of a started response.
    status: func(handle: u64) -> result<u16, string>;

    /// One response header value (e.g. content-type, mcp-session-id).
    header: func(handle: u64, name: string) -> result<option<string>, string>;

    /// Read up to `max` bytes of the response body. Returns as soon as at
    /// least one byte is available or the stream ends (eof = true) — the
    /// same contract as process.read-stdout, so SSE streams can be
    /// consumed incrementally and closed early.
    read-body: func(handle: u64, max: u32) -> result<tuple<list<u8>, bool>, string>;

    /// Close the response and release the handle.
    close: func(handle: u64);
}


/// WebSocket connections: a scoped network capability for bridge
/// components (IM stream modes — docs/im-channels.md). The host is a
/// frame pipe only: it never parses payloads. Origin consent shares the
/// `http` allowlist (ws: matches http:, wss: matches https:).
interface ws {
    /// One wire frame. Text frames carry UTF-8 (IM stream protocols are
    /// text-frame JSON); the pipe is honest about the wire shape.
    variant frame {
        text(string),
        binary(list<u8>),
    }

    /// Connect to a ws(s) URL. The origin must be in the consent
    /// allowlist (same rule as http.request); a refusal names the
    /// origin. Returns a handle.
    connect: func(url: string) -> result<u64, string>;

    /// Send one frame.
    send: func(handle: u64, frame: frame) -> result<_, string>;

    /// Receive the next frame, waiting at most `timeout-ms` (must be
    /// > 0 — a recv that can block forever makes a dead connection
    /// indistinguishable from a quiet one, wit-review F9). On timeout
    /// returns an explicit error. The host pings every 30s and closes
    /// the connection after 60s without any inbound frame or pong;
    /// that close surfaces here as an error naming the reason.
    /// Reconnect and catch-up are the component's job.
    recv: func(handle: u64, timeout-ms: u32) -> result<frame, string>;

    /// Close and release the handle. Handles carry a generation: a
    /// stale handle after a trap rebuild errors instead of aliasing a
    /// newer connection (same rule as process).
    close: func(handle: u64) -> result<_, string>;
}

/// Bridge components translate an external tool protocol (MCP today) into
/// tau tools. The host knows nothing about that protocol; it only grants
/// the capabilities the bridge declares (process spawn, scoped http).
/// Both capabilities are always linked but granted empty by default: with
/// no consent they fail at call time, not instantiation time.
world bridge {
    import process;
    import http;
    import ws;
    export tools;
}
